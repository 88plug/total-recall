#!/usr/bin/env bash
# SessionStart hook (matcher: startup|clear).
# Emits a small "signpost" pointing at prior memory for this cwd. The point is
# discoverability without bloat — the model learns memory *exists*, not what's
# in it. Detailed retrieval is on demand via MCP / UserPromptSubmit.
#
# Guarantees:
#   - never blocks the session (exit 0 on every error path)
#   - silent (no stdout) when there's no DB or no memories
#   - 5s wall-clock budget; aborts and exits 0 on overrun

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$HOOK_DIR/lib/common.sh"

recall::start_timer
EMITTED="false"

# Defensive: any unexpected failure → exit 0, never propagate.
trap 'recall::log "session-start: unexpected exit ($?)"; recall::log_json hook.session_start elapsed_ms="$(recall::elapsed_ms)" cwd="${CWD:-}" session_id="${SESSION_ID:-}" emitted="$EMITTED" error="trap"; exit 0' ERR

recall::read_input
CWD="$(recall::field cwd)"
[ -n "$CWD" ] || CWD="${CLAUDE_PROJECT_DIR:-${PWD:-/unknown}}"
SESSION_ID="$(recall::field session_id)"

if ! recall::has_jq || ! recall::has_py; then
  recall::log "session-start: missing jq or python3; skipping (cwd=$CWD)"
  exit 0
fi

# First-run path: a fresh install opens its first session with no DB. Kick
# the backfill in the background and tell the user what's happening — exactly
# once. We pick SessionStart over UserPromptSubmit when both fire because the
# user is more receptive to setup messages right at session start.
if recall::is_fresh_install; then
  recall::start_bootstrap "SessionStart"
  MARKER="${RECALL_DATA_ROOT}/.bootstrap_banner_shown"
  if [ ! -f "$MARKER" ]; then
    BANNER="$(recall::bootstrap_banner SessionStart)"
    recall::emit_context "$BANNER" "SessionStart" \
      && touch "$MARKER" 2>/dev/null \
      && EMITTED="true"
    recall::log "session-start: first-run bootstrap banner emitted"
  fi
  recall::log_json hook.session_start elapsed_ms="$(recall::elapsed_ms)" cwd="$CWD" session_id="$SESSION_ID" emitted="$EMITTED" bootstrap="started"
  exit 0
fi

# Run the Python bridge with a hard 5s ceiling. `timeout` returns 124 on kill
# — we treat that the same as "no memory available" and just stay silent.
CTX=""
if command -v timeout >/dev/null 2>&1; then
  CTX="$(timeout 5s python3 "$HOOK_DIR/lib/query.py" signpost \
            --cwd "$CWD" --max-tokens 200 2>/dev/null || true)"
else
  CTX="$(python3 "$HOOK_DIR/lib/query.py" signpost \
            --cwd "$CWD" --max-tokens 200 2>/dev/null || true)"
fi

if [ -z "${CTX// }" ]; then
  recall::log "session-start: no signpost (cwd=$CWD session=$SESSION_ID)"
  recall::log_json hook.session_start elapsed_ms="$(recall::elapsed_ms)" cwd="$CWD" session_id="$SESSION_ID" emitted="$EMITTED"
  exit 0
fi

recall::emit_context "$CTX" "SessionStart" || {
  recall::log "session-start: emit failed (cwd=$CWD)"
  recall::log_json hook.session_start elapsed_ms="$(recall::elapsed_ms)" cwd="$CWD" session_id="$SESSION_ID" emitted="$EMITTED" error="emit_failed"
  exit 0
}

EMITTED="true"
recall::log "session-start: signpost emitted (${#CTX} chars cwd=$CWD session=$SESSION_ID)"
recall::log_json hook.session_start elapsed_ms="$(recall::elapsed_ms)" cwd="$CWD" session_id="$SESSION_ID" emitted="$EMITTED"
exit 0
