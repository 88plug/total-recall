{
  "description": "total-recall: cross-session memory layer. SessionStart emits a tiny signpost pointing at prior sessions for this cwd; UserPromptSubmit (async) fetches highly-relevant memories on demand; Stop/PostCompact (async) re-index. Matcher 'startup|clear' on SessionStart keeps us out of amnesia's way for compact/resume. Timeout note: fast/deterministic hooks follow the 88plug spec (SessionStart/compact-restore/recovery=15, UserPromptSubmit=10, PreCompact=30); the async re-index hooks (Stop, PostCompact index) intentionally keep timeout=60 since corpus indexing runs detached and must not be killed mid-write.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start-signpost.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start-compact-restore.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-retrieve.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-index.sh",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact-seed.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-compact-recovery.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-compact-index.sh",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
