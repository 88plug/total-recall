{
  "description": "total-recall: cross-session memory layer. SessionStart emits a tiny signpost pointing at prior sessions for this cwd; UserPromptSubmit (async) fetches highly-relevant memories on demand; Stop/PostCompact (async) re-index. Matcher 'startup|clear' on SessionStart keeps us out of amnesia's way for compact/resume.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT:-.}/hooks/session-start-signpost.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT:-.}/hooks/user-prompt-retrieve.sh",
            "timeout": 8,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT:-.}/hooks/stop-index.sh",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT:-.}/hooks/pre-compact-seed.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT:-.}/hooks/post-compact-recovery.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT:-.}/hooks/post-compact-index.sh",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
