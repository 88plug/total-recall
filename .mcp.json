{
  "mcpServers": {
    "total-recall": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT:-.}",
        "python",
        "-m",
        "mcp_server"
      ],
      "env": {
        "TOTAL_RECALL_DB_DIR": "${CLAUDE_PLUGIN_DATA:-${HOME}/.claude/plugins/data/total-recall-88plug}/total-recall",
        "TOTAL_RECALL_EMBED_MODEL": "Alibaba-NLP/gte-modernbert-base"
      }
    }
  }
}
